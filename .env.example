# Local development. Never commit .env or paste credentials into chat.
# Node.js 24 loads this file through npm start; host environment variables win.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
TRUST_PROXY=0

# Private directory with durable storage. Production needs a persistent disk.
# Database file: DATA_DIR/sahni.sqlite. Never put this under public/.
DATA_DIR=.data

# Generate with npm run admin:password. Keep a strong unique password in a
# password manager. Single-quote the hash so Compose preserves its dollar signs.
# With no hash, the administrator login remains disabled.
ADMIN_PASSWORD_HASH=''

# Payments remain disabled until all three are configured.
# Start with a real matched TEST key pair from your Razorpay dashboard.
# The key ID is public; the API key secret and webhook secret are private.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Only used by the supplied Docker Compose / Caddy deployment.
# Hostname only, no https:// or path. Set DNS before enabling public HTTPS.
APP_DOMAIN=
ACME_EMAIL=
