{
  "name": "sahni-astrologers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sahni Astrologers website with server-verified bookings and payments",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "preview:build": "npm run build && node scripts/preview.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "astronomy-engine": "2.1.19",
    "axios": "1.21.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
